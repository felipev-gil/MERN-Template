NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Generate a random secret (see README); do not use this placeholder.
JWT_SECRET=replace-with-a-random-secret
MONGO_URI=mongodb://127.0.0.1:27017/mern_template
# Optional: disabled means no Redis connection is made.
RATE_LIMIT_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set only when your host documents the exact number of trusted proxy hops.
TRUST_PROXY_HOPS=0
